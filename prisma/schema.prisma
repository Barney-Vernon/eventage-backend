generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
  CLIENT
  VENDOR
}

enum EventStatus {
  INQUIRY
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  UNPAID
  PAID
  OVERDUE
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(STAFF)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Client {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  phone     String
  events    Event[]
  createdAt DateTime @default(now())
}

model Event {
  id          Int         @id @default(autoincrement())
  title       String
  description String?     @db.Text
  eventDate   DateTime
  venue       String
  status      EventStatus @default(INQUIRY)
  clientId    Int
  client      Client      @relation(fields: [clientId], references: [id])
  resources   EventResource[]
  invoices    Invoice[]
  createdAt   DateTime    @default(now())
}

model Resource {
  id           Int             @id @default(autoincrement())
  name         String
  totalQty     Int
  availableQty Int
  events       EventResource[]
}

model EventResource {
  id         Int      @id @default(autoincrement())
  eventId    Int
  resourceId Int
  quantity   Int
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  resource   Resource @relation(fields: [resourceId], references: [id])
}

model Invoice {
  id        Int           @id @default(autoincrement())
  eventId   Int
  amount    Float
  status    InvoiceStatus @default(UNPAID)
  mpesaRef  String?       @unique
  event     Event         @relation(fields: [eventId], references: [id])
  createdAt DateTime      @default(now())
}